{{ 'awc-home.css' | asset_url | stylesheet_tag }}
<section class="awc-s awc-pad" style="background:#fff">
  <div class="awc-wrap">
    <div class="awc-head">
      <span class="awc-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="awc-h">{{ section.settings.heading }}</h2>
    </div>
    <div class="awc-fq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}><summary>{{ block.settings.q }}</summary><div class="a">{{ block.settings.a }}</div></details>
      {%- endfor -%}
    </div>
    {%- if section.settings.more_link != blank -%}
      <div class="awc-sub" style="justify-content:center"><a href="{{ section.settings.more_link }}">{{ section.settings.more_text }} &rarr;</a></div>
    {%- endif -%}
  </div>
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
    {%- for block in section.blocks -%}
      {"@type":"Question","name":{{ block.settings.q | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | strip_html | json }}}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    ]}
  </script>
</section>

{% schema %}
{
  "name": "AWC FAQ (compact)",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small line","default":"Good to know"},
    {"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},
    {"type":"url","id":"more_link","label":"More link"},
    {"type":"text","id":"more_text","label":"More link text","default":"All questions answered"}
  ],
  "blocks": [
    {"type":"qa","name":"Question","settings":[{"type":"text","id":"q","label":"Question"},{"type":"richtext","id":"a","label":"Answer"}]}
  ],
  "presets": [{"name":"AWC FAQ (compact)"}]
}
{% endschema %}
