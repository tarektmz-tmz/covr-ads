{% liquid
  assign show_title = section.settings.show_title
  assign title_alignment = section.settings.title_alignment
  assign title_size = section.settings.title_size
  assign container_size = section.settings.container_size
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign background_color = section.settings.background_color
  assign text_color = section.settings.text_color

  comment
    Model guide pages show the real watches in stock for that model, pulled live from its collection.
  endcomment
  assign stock_collection = ''
  case page.handle
    when 'rolex-submariner-dubai'
      assign stock_collection = 'rolex-submariner'
    when 'rolex-daytona-dubai'
      assign stock_collection = 'rolex-daytona'
    when 'rolex-gmt-master-ii-dubai'
      assign stock_collection = 'rolex-gmt-master-ii'
    when 'rolex-datejust-41-dubai'
      assign stock_collection = 'rolex-datejust-41mm'
    when 'rolex-day-date-40-dubai'
      assign stock_collection = 'rolex-day-date'
    when 'rolex-sky-dweller-dubai'
      assign stock_collection = 'rolex-sky-dweller'
    when 'rolex-yacht-master-dubai'
      assign stock_collection = 'rolex-yacht-master'
    when 'rolex-land-dweller-dubai'
      assign stock_collection = 'rolex-land-dweller'
    when 'rolex-air-king-dubai'
      assign stock_collection = 'rolex-air-king'
  endcase
%}

<div
  class="{{ padding_top }} {{ padding_bottom }}"
  {% if background_color != blank %}
    style="--bg-color: {{ background_color }}; background-color: var(--bg-color);"
  {% endif %}
>
  <div class="page-width {{ container_size }}">
    {%- if show_title -%}
      <div class="mb-8 {{ title_alignment }}">
        <h1
          class="{{ title_size }}"
          {% if text_color != blank %}
            style="color: {{ text_color }};"
          {% endif %}
        >
          {{ page.title }}
        </h1>
      </div>
    {%- endif -%}

    <div
      class="prose prose-lg max-w-none{% if text_color != blank %} prose-invert{% endif %}"
      {% if text_color != blank %}
        style="color: {{ text_color }};"
      {% endif %}
    >
      {{ page.content }}
    </div>
  </div>
</div>

{%- if stock_collection != '' and collections[stock_collection].products_count > 0 -%}
  {%- assign stock = collections[stock_collection] -%}
  <style>
    .pis { padding: 36px 16px 56px; }
    .pis-in { max-width: 1200px; margin: 0 auto; }
    .pis-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 20px; margin-bottom: 20px; }
    .pis-head h2 { margin: 0; font-size: 26px; font-weight: 600; color: #111; letter-spacing: -.2px; }
    .pis-head a { color: #8a6d1f; font-weight: 600; text-decoration: none; }
    .pis-head a:hover { text-decoration: underline; }
    .pis-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    @media (min-width: 900px) { .pis-grid { grid-template-columns: repeat(4, 1fr); gap: 20px; } }
  </style>
  <section class="pis" aria-label="{{ stock.title | escape }} in stock">
    <div class="pis-in">
      <div class="pis-head">
        <h2>{{ stock.title }}: available now</h2>
        <a href="{{ stock.url }}">See all {{ stock.products_count }} →</a>
      </div>
      <div class="pis-grid">
        {%- for product in stock.products limit: 8 -%}
          {%- render 'product-card', product: product, collection: stock -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Main Page",
  "tag": "section",
  "enabled_on": {
    "templates": ["page"]
  },
  "limit": 1,
  "settings": [
    {"type": "header", "content": "Title Settings"},
    {"type": "checkbox", "id": "show_title", "label": "Show Page Title", "default": true},
    {"type": "select", "id": "title_alignment", "label": "Title Alignment", "options": [{"value": "text-left", "label": "Left"}, {"value": "text-center", "label": "Center"}, {"value": "text-right", "label": "Right"}], "default": "text-center", "visible_if": "{{ section.settings.show_title == true }}"},
    {"type": "select", "id": "title_size", "label": "Title Size", "options": [{"value": "text-2xl md:text-3xl", "label": "Small"}, {"value": "text-3xl md:text-4xl", "label": "Medium"}, {"value": "text-4xl md:text-5xl", "label": "Large"}, {"value": "text-5xl md:text-6xl", "label": "Extra Large"}], "default": "text-3xl md:text-4xl", "visible_if": "{{ section.settings.show_title == true }}"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "container_size", "label": "Container Size", "options": [{"value": "max-w-3xl mx-auto", "label": "Narrow"}, {"value": "max-w-4xl mx-auto", "label": "Medium"}, {"value": "max-w-5xl mx-auto", "label": "Wide"}, {"value": "", "label": "Default"}, {"value": "max-w-none", "label": "Full Width"}], "default": "max-w-4xl mx-auto"},
    {"type": "header", "content": "Spacing"},
    {"type": "select", "id": "padding_top", "label": "Top Padding", "options": [{"value": "pt-0", "label": "None"}, {"value": "pt-8 md:pt-12", "label": "Small"}, {"value": "pt-12 md:pt-16", "label": "Medium"}, {"value": "pt-16 md:pt-24", "label": "Large"}, {"value": "pt-24 md:pt-32", "label": "Extra Large"}], "default": "pt-12 md:pt-16"},
    {"type": "select", "id": "padding_bottom", "label": "Bottom Padding", "options": [{"value": "pb-0", "label": "None"}, {"value": "pb-8 md:pb-12", "label": "Small"}, {"value": "pb-12 md:pb-16", "label": "Medium"}, {"value": "pb-16 md:pb-24", "label": "Large"}, {"value": "pb-24 md:pb-32", "label": "Extra Large"}], "default": "pb-12 md:pb-16"},
    {"type": "header", "content": "Colors"},
    {"type": "color", "id": "background_color", "label": "Background Color"},
    {"type": "color", "id": "text_color", "label": "Text Color"}
  ],
  "presets": [{"name": "Main Page", "category": "Content"}]
}
{% endschema %}
