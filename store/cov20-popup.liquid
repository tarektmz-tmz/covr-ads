<!-- COVR · COV20 offer pop-up. Paste into a "Custom Liquid" section in the theme footer.
     Shows 3 seconds after every page load. Ends automatically after 26 Oct 2026 (HKT). -->
<div id="covr-pop" class="covr-pop" aria-hidden="true">
  <div class="covr-pop__card" role="dialog" aria-modal="true" aria-labelledby="covr-pop-title">
    <button class="covr-pop__x" type="button" aria-label="Close">&times;</button>
    <p class="covr-pop__kicker">COVR</p>
    <h2 id="covr-pop-title" class="covr-pop__title">Claim your limited-time offer</h2>
    <p class="covr-pop__sub">20% off every racket cover, until 26 October.</p>

    <button class="covr-pop__btn" type="button" data-claim>Claim it now</button>

    <div class="covr-pop__reveal" hidden>
      <p class="covr-pop__label">Your code</p>
      <button class="covr-pop__code" type="button" data-copy title="Copy code">COV20</button>
      <p class="covr-pop__copied" aria-live="polite"></p>
      <a class="covr-pop__btn covr-pop__btn--solid" href="/discount/COV20?redirect=/collections/all">Shop with 20% off</a>
      <p class="covr-pop__fine">Applied automatically when you shop from this button. Covers only.</p>
    </div>
  </div>
</div>

<style>
  .covr-pop *,.covr-pop *::before{box-sizing:border-box}
  .covr-pop [hidden]{display:none!important}
  .covr-pop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;
    background:rgba(20,16,12,.55);opacity:0;visibility:hidden;transition:opacity .35s ease,visibility .35s}
  .covr-pop.is-open{opacity:1;visibility:visible}
  .covr-pop__card{position:relative;width:100%;max-width:420px;background:#f5f0e6;color:#1d1a17;border-radius:4px;
    padding:44px 32px 34px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.35);transform:translateY(12px);transition:transform .35s ease}
  .covr-pop.is-open .covr-pop__card{transform:none}
  .covr-pop__x{position:absolute;top:10px;right:14px;border:0;background:none;font-size:28px;line-height:1;color:#6f6a62;cursor:pointer}
  .covr-pop__kicker{margin:0 0 14px;letter-spacing:.42em;font-size:13px;color:#9b6b3e}
  .covr-pop__title{margin:0 0 10px;font-size:28px;line-height:1.15;font-weight:500;letter-spacing:-.01em}
  .covr-pop__sub{margin:0 0 26px;font-size:15px;color:#5d5750}
  .covr-pop__btn{display:inline-block;width:100%;padding:16px 20px;border:1px solid #1d1a17;background:none;color:#1d1a17;
    font-size:13px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;text-decoration:none}
  .covr-pop__btn--solid{background:#1d1a17;color:#f5f0e6;margin-top:18px}
  .covr-pop__label{margin:0 0 8px;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#8c857c}
  .covr-pop__code{display:block;width:100%;padding:14px;border:1px dashed #9b6b3e;background:#fff;font-size:26px;
    letter-spacing:.3em;font-weight:600;color:#1d1a17;cursor:pointer}
  .covr-pop__copied{min-height:18px;margin:8px 0 0;font-size:13px;color:#2f7a4a}
  .covr-pop__fine{margin:14px 0 0;font-size:12px;color:#8c857c}
</style>

<script>
  (function () {
    var END = new Date('2026-10-26T15:59:59Z');            // same end as the COV20 code
    if (new Date() > END) return;
    var pop = document.getElementById('covr-pop');
    if (!pop) return;
    var reveal = pop.querySelector('.covr-pop__reveal');
    var claim = pop.querySelector('[data-claim]');

    function open() {
      pop.classList.add('is-open'); pop.setAttribute('aria-hidden', 'false');
    }
    function close() { pop.classList.remove('is-open'); pop.setAttribute('aria-hidden', 'true'); }

    setTimeout(open, 3000);
    pop.addEventListener('click', function (e) { if (e.target === pop) close(); });
    pop.querySelector('.covr-pop__x').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    claim.addEventListener('click', function () { claim.hidden = true; reveal.hidden = false; });

    pop.querySelector('[data-copy]').addEventListener('click', function () {
      var msg = pop.querySelector('.covr-pop__copied');
      if (navigator.clipboard) navigator.clipboard.writeText('COV20').then(function () { msg.textContent = 'Copied'; });
    });
  })();
</script>
