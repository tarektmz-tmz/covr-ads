    "awc_faq": {
      "type": "awc-faq",
      "settings": {
        "eyebrow": "Good to know",
        "heading": "Frequently asked questions",
        "more_link": "/pages/rolex-faq-dubai",
        "more_text": "All questions answered"
      },
      "blocks": {
        "b1": {
          "type": "qa",
          "settings": {
            "q": "What condition are the watches you sell?",
            "a": "<p>Most of our watches are unworn. For discontinued models, we can also source pre-owned and like-new watches.</p>"
          }
        },
        "b2": {
          "type": "qa",
          "settings": {
            "q": "Does the watch come with a box and papers?",
            "a": "<p>Yes. Our watches come as a full set, with box and papers.</p>"
          }
        },
        "b3": {
          "type": "qa",
          "settings": {
            "q": "Is there a manufacturer’s warranty?",
            "a": "<p>Yes, if the watch is less than 5 years old. Watches are sold with the remaining manufacturer guarantee, counted from the original purchase date. Rolex offers a 5-year worldwide guarantee.</p>"
          }
        },
        "b4": {
          "type": "qa",
          "settings": {
            "q": "How long does delivery take?",
            "a": "<p>Same-day delivery in Dubai, or 24–48 hours across the UAE, depending on the watch’s availability.</p>"
          }
        },
        "b5": {
          "type": "qa",
          "settings": {
            "q": "Why can’t I buy a luxury watch at the retail store?",
            "a": "<p>Retail shops have had little or no availability for years, with waiting lists of 2–8 years for some watches. The secondary market is where you can find almost any watch, at a premium price.</p>"
          }
        },
        "b6": {
          "type": "qa",
          "settings": {
            "q": "Do you only sell Rolex?",
            "a": "<p>No. Besides Rolex we offer Audemars Piguet, Patek Philippe, Richard Mille and other prestigious brands.</p>"
          }
        },
        "b7": {
          "type": "qa",
          "settings": {
            "q": "What do you mean by watch sourcing?",
            "a": "<p>We find the watch you want, even if it’s not in our collection. We search far and wide for the exact timepiece you’re looking for.</p>"
          }
        },
        "b8": {
          "type": "qa",
          "settings": {
            "q": "Do you buy or trade watches?",
            "a": "<p>Yes. Reach out and one of our team will assist you with the process.</p>"
          }
        },
        "b9": {
          "type": "qa",
          "settings": {
            "q": "What do I need to know before buying?",
            "a": "<p>Research the models, buy from a reputable dealer, check the condition, compare prices, ask for certification and warranty, and choose a seller with real after-sales support.</p>"
          }
        },
        "b10": {
          "type": "qa",
          "settings": {
            "q": "What payment methods do you accept?",
            "a": "<p>Bank transfer, cash, crypto and credit cards (applicable fees). A 25% deposit confirms your order, with the balance paid on delivery.</p>"
          }
        }
      },
