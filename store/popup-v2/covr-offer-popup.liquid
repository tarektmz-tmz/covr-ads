{%- comment -%}
  COVR offer pop-up (footer group, every page).

  "Scratch your luck": a scratch card that reveals the offer (or, with style
  "Button", the offer shown straight away). Its button leads to `link`
  (default the offer page, /pages/offer, where the visitor leaves an email
  and the code is sent by email from Shopify Messaging, so it is never shown
  here). `[amount]` and `[minimum]` in the text print those sums in the
  visitor's currency (snippets/covr-offer-text.liquid); keep offer_amount and
  offer_minimum equal to the discount code.

  8 Nov 2026: `show_on` lets two pop-ups share the site: the Signature offer
  ($50, code COVR50) everywhere except the Essential pages, and an Essential
  launch message (40% off, no code) on the Essential product and collection
  pages. Both remember a close in the same place, so a visitor sees at most
  one pop-up per `dismiss_days`.

  Switches (theme editor):
    enabled    show to every visitor
    test_mode  while not enabled: show only when the address has
               ?covr_popup=test (then for the rest of that browser session;
               ?covr_popup=off ends it)
  Appears once, a few seconds after arrival (delay settings), and waits while
  the cookie banner or a drawer is open. Never on the offer page, the cart,
  customer account pages or the password page. Closing it hides it for
  `dismiss_days`; claiming it hides it for good (this browser only).

  Phones: a small card at the foot of the screen with no backdrop.
  Desktop: a centred dialog. assets/covr-offer.js, assets/covr-offer.css.
{%- endcomment -%}

{%- liquid
  assign covr_show = false
  if section.settings.enabled or section.settings.test_mode or request.design_mode
    assign covr_show = true
  endif
  if template.name == 'cart' or template.name == 'password' or template.name == 'gift_card' or template.directory == 'customers'
    assign covr_show = false
  endif
  if template.name == 'page' and template.suffix == 'offer'
    assign covr_show = false
  endif

  assign covr_essential_page = false
  if template.suffix == 'essential'
    assign covr_essential_page = true
  endif
  if template.name == 'collection' and collection.handle == 'essential'
    assign covr_essential_page = true
  endif
  if section.settings.show_on == 'essential' and covr_essential_page == false
    assign covr_show = false
  endif
  if section.settings.show_on == 'not_essential' and covr_essential_page
    assign covr_show = false
  endif

  assign covr_link = section.settings.link | default: '/pages/offer'
  assign covr_style = section.settings.style
  assign covr_img = section.settings.image
  assign covr_amount = section.settings.offer_amount | default: 20
  assign covr_minimum = section.settings.offer_minimum | default: 0
-%}

{%- if covr_show -%}
  {{ 'covr-offer.css' | asset_url | stylesheet_tag }}
  <covr-offer-popup
    class="covr-pop covr-pop--{{ covr_style }}"
    data-mode="{% if section.settings.enabled %}live{% else %}test{% endif %}"
    data-delay-min="{{ section.settings.delay_min }}"
    data-delay-max="{{ section.settings.delay_max }}"
    data-dismiss-days="{{ section.settings.dismiss_days }}"
    data-section-id="{{ section.id }}"
    {% if request.design_mode %}
      data-design-mode
    {% endif %}
    hidden
    {{ section.shopify_attributes }}
  >
    <div class="covr-pop__backdrop" data-covr-offer-close></div>
    <div
      class="covr-pop__card{% if covr_img != blank %} covr-pop__card--media{% endif %}"
      role="dialog"
      aria-labelledby="CovrOfferTitle-{{ section.id }}"
      tabindex="-1"
    >
      <button type="button" class="covr-pop__close" data-covr-offer-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linecap="round"/>
        </svg>
      </button>

      {%- if covr_img != blank -%}
        <div class="covr-pop__media">
          <img
            src="{{ covr_img | image_url: width: 700 }}"
            srcset="{{ covr_img | image_url: width: 400 }} 400w, {{ covr_img | image_url: width: 700 }} 700w"
            sizes="340px"
            width="{{ covr_img.width }}"
            height="{{ covr_img.height }}"
            alt=""
            loading="lazy"
            decoding="async"
          >
        </div>
      {%- endif -%}

      <div class="covr-pop__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="covr-pop__eyebrow">{%- render 'covr-offer-text', text: section.settings.eyebrow, amount: covr_amount, minimum: covr_minimum -%}</p>
        {%- endif -%}
        <h2 class="covr-pop__title" id="CovrOfferTitle-{{ section.id }}">{%- render 'covr-offer-text', text: section.settings.heading, amount: covr_amount, minimum: covr_minimum -%}</h2>

        {%- if covr_style == 'scratch' -%}
          <div class="covr-pop__scratch" data-covr-offer-scratch>
            <p class="covr-pop__prize" data-covr-offer-prize aria-hidden="true">
              <span class="covr-pop__prize-value">{%- render 'covr-offer-text', text: section.settings.prize, amount: covr_amount, minimum: covr_minimum -%}</span>
              <span class="covr-pop__prize-note">{%- render 'covr-offer-text', text: section.settings.prize_note, amount: covr_amount, minimum: covr_minimum -%}</span>
            </p>
            <canvas class="covr-pop__foil" data-covr-offer-foil aria-hidden="true"></canvas>
          </div>
          <p class="covr-pop__hint" data-covr-offer-hint>
            {{ section.settings.scratch_hint | escape }}
            <button type="button" class="covr-pop__reveal" data-covr-offer-reveal>
              {{- section.settings.reveal_label | escape -}}
            </button>
          </p>
          <p class="visually-hidden" aria-live="polite" data-covr-offer-live></p>
        {%- else -%}
          <p class="covr-pop__prize covr-pop__prize--plain">
            <span class="covr-pop__prize-value">{%- render 'covr-offer-text', text: section.settings.prize, amount: covr_amount, minimum: covr_minimum -%}</span>
            <span class="covr-pop__prize-note">{%- render 'covr-offer-text', text: section.settings.prize_note, amount: covr_amount, minimum: covr_minimum -%}</span>
          </p>
        {%- endif -%}

        <a
          class="covr-pop__cta"
          href="{{ covr_link }}"
          data-covr-offer-claim
          {% if covr_style == 'scratch' %}
            hidden
          {% endif %}
        >
          {%- render 'covr-offer-text', text: section.settings.button_label, amount: covr_amount, minimum: covr_minimum -%}
        </a>
        {%- if section.settings.small_print != blank -%}
          <p class="covr-pop__small">{%- render 'covr-offer-text', text: section.settings.small_print, amount: covr_amount, minimum: covr_minimum -%}</p>
        {%- endif -%}
      </div>
    </div>
  </covr-offer-popup>
  <script src="{{ 'covr-offer.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "COVR offer pop-up",
  "tag": "section",
  "class": "covr-offer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show to all visitors",
      "info": "For an email offer, leave off until the email that sends the code is set up in Shopify Messaging.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "label": "Test mode",
      "info": "While not shown to all visitors: show only when the address ends in ?covr_popup=test",
      "default": true
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show on",
      "options": [
        { "value": "all", "label": "Every page" },
        { "value": "not_essential", "label": "Every page except the Essential pages" },
        { "value": "essential", "label": "Essential product and collection pages only" }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "scratch", "label": "Scratch card" },
        { "value": "simple", "label": "Button" }
      ],
      "default": "scratch"
    },
    { "type": "range", "id": "delay_min", "min": 1, "max": 30, "step": 1, "unit": "s", "label": "Show after at least", "default": 5 },
    { "type": "range", "id": "delay_max", "min": 1, "max": 30, "step": 1, "unit": "s", "label": "and at most", "default": 10 },
    { "type": "range", "id": "dismiss_days", "min": 1, "max": 60, "step": 1, "unit": "d", "label": "After closing, hide for", "default": 14 },
    { "type": "image_picker", "id": "image", "label": "Photograph (desktop only)" },
    { "type": "number", "id": "offer_amount", "label": "Offer amount, store currency", "info": "Must match the discount code. Shown wherever the text says [amount], in the visitor's currency.", "default": 20 },
    { "type": "number", "id": "offer_minimum", "label": "Minimum order, store currency", "info": "Must match the discount code. Shown wherever the text says [minimum].", "default": 100 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Scratch your luck" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Claim your one-time limited offer" },
    { "type": "text", "id": "prize", "label": "Offer", "default": "[amount]" },
    { "type": "text", "id": "prize_note", "label": "Offer line", "default": "to spend on your order" },
    { "type": "text", "id": "scratch_hint", "label": "Scratch card hint", "default": "Scratch the card to reveal your offer." },
    { "type": "text", "id": "reveal_label", "label": "Reveal link", "default": "Reveal it" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Claim your [amount]" },
    { "type": "url", "id": "link", "label": "Button link", "info": "The page where visitors leave their email (default /pages/offer), or any page for a message without a code." },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Leave your email on the next page and we'll send your code. One use per customer, on orders of [minimum] or more." }
  ],
  "presets": [{ "name": "COVR offer pop-up" }]
}
{% endschema %}
