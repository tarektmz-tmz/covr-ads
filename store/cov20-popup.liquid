<!-- COVR · COV20 scratch-card pop-up. Paste into a "Custom Liquid" section in the theme footer.
     Shows 3 seconds after someone opens the site, once per visit (not again while they browse pages;
     shows again when they close the tab/browser and come back). Visitor scratches (mouse or finger) to reveal the code.
     Ends automatically after 26 Oct 2026 (HKT). -->
<div id="covr-pop" class="covr-pop" aria-hidden="true">
  <div class="covr-pop__card" role="dialog" aria-modal="true" aria-labelledby="covr-pop-title">
    <button class="covr-pop__x" type="button" aria-label="Close">&times;</button>
    <p class="covr-pop__kicker">COVR</p>
    <h2 id="covr-pop-title" class="covr-pop__title">Claim your limited time offer</h2>

    <div class="covr-pop__scratch">
      <div class="covr-pop__prize">
        <span class="covr-pop__pct">20% OFF</span>
        <button class="covr-pop__code" type="button" data-copy title="Copy code">COV20</button>
      </div>
      <canvas class="covr-pop__foil" aria-label="Scratch to reveal your offer"></canvas>
    </div>
    <p class="covr-pop__hint">Scratch to reveal your mystery offer</p>

    <div class="covr-pop__reveal" hidden>
      <p class="covr-pop__copied" aria-live="polite"></p>
      <a class="covr-pop__btn" href="/discount/COV20?redirect=/collections/all">Shop with 20% off</a>
      <p class="covr-pop__fine">Applied automatically when you shop from this button. Covers only.</p>
    </div>
  </div>
</div>

<style>
  .covr-pop *,.covr-pop *::before{box-sizing:border-box}
  .covr-pop [hidden]{display:none!important}
  .covr-pop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;
    background:rgba(20,16,12,.55);opacity:0;visibility:hidden;transition:opacity .35s ease,visibility .35s}
  .covr-pop.is-open{opacity:1;visibility:visible}
  .covr-pop__card{position:relative;width:100%;max-width:420px;background:#f5f0e6;color:#1d1a17;border-radius:4px;
    padding:44px 32px 34px;text-align:center;box-shadow:0 30px 80px rgba(0,0,0,.35);transform:translateY(12px);transition:transform .35s ease}
  .covr-pop.is-open .covr-pop__card{transform:none}
  .covr-pop__x{position:absolute;top:10px;right:14px;border:0;background:none;font-size:28px;line-height:1;color:#6f6a62;cursor:pointer}
  .covr-pop__kicker{margin:0 0 14px;letter-spacing:.42em;font-size:13px;color:#9b6b3e}
  .covr-pop__title{margin:0 0 24px;font-size:28px;line-height:1.15;font-weight:500;letter-spacing:-.01em}
  .covr-pop__scratch{position:relative;height:150px;border-radius:6px;overflow:hidden;border:1px dashed #9b6b3e;background:#fff}
  .covr-pop__prize{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
  .covr-pop__pct{font-size:40px;font-weight:700;letter-spacing:.04em;color:#1d1a17}
  .covr-pop__code{border:0;background:none;font-size:22px;letter-spacing:.32em;font-weight:600;color:#9b6b3e;cursor:pointer;padding:4px 8px}
  .covr-pop__foil{position:absolute;inset:0;width:100%;height:100%;cursor:crosshair;touch-action:none;transition:opacity .5s ease}
  .covr-pop__foil.is-gone{opacity:0;pointer-events:none}
  .covr-pop__hint{margin:12px 0 0;font-size:13px;color:#8c857c}
  .covr-pop__copied{min-height:18px;margin:10px 0 0;font-size:13px;color:#2f7a4a}
  .covr-pop__btn{display:inline-block;width:100%;margin-top:8px;padding:16px 20px;border:1px solid #1d1a17;background:#1d1a17;color:#f5f0e6;
    font-size:13px;letter-spacing:.18em;text-transform:uppercase;cursor:pointer;text-decoration:none}
  .covr-pop__fine{margin:14px 0 0;font-size:12px;color:#8c857c}
</style>

<script>
  (function () {
    var END = new Date('2026-10-26T15:59:59Z');            // same end as the COV20 code
    if (new Date() > END) return;
    var KEY = 'covr_cov20_popup_seen';                   // sessionStorage: cleared when the tab closes
    try { if (sessionStorage.getItem(KEY)) return; } catch (e) {}
    var pop = document.getElementById('covr-pop');
    if (!pop) return;
    var foil = pop.querySelector('.covr-pop__foil');
    var hint = pop.querySelector('.covr-pop__hint');
    var reveal = pop.querySelector('.covr-pop__reveal');
    var ctx = foil.getContext('2d');
    var done = false, drawing = false, last = null, moves = 0;

    function paintFoil() {
      var r = foil.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
      foil.width = r.width * dpr; foil.height = r.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      var g = ctx.createLinearGradient(0, 0, r.width, r.height);
      g.addColorStop(0, '#c9a77c'); g.addColorStop(.5, '#e4cfae'); g.addColorStop(1, '#b08a5e');
      ctx.fillStyle = g; ctx.fillRect(0, 0, r.width, r.height);
      ctx.fillStyle = 'rgba(29,26,23,.75)'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.font = '600 15px sans-serif'; ctx.fillText('S C R A T C H   H E R E', r.width / 2, r.height / 2 - 12);
      ctx.font = '13px sans-serif'; ctx.fillText('?  mystery offer  ?', r.width / 2, r.height / 2 + 14);
      ctx.globalCompositeOperation = 'destination-out';
      ctx.lineWidth = 42; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    }
    function pos(e) { var r = foil.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
    function scratch(p) {
      ctx.beginPath();
      if (last) { ctx.moveTo(last.x, last.y); ctx.lineTo(p.x, p.y); ctx.stroke(); }
      else { ctx.arc(p.x, p.y, 21, 0, Math.PI * 2); ctx.fill(); }
      last = p;
      if (++moves % 8 === 0) check();
    }
    function check() {
      var d = ctx.getImageData(0, 0, foil.width, foil.height).data, clear = 0, n = 0;
      for (var i = 3; i < d.length; i += 64) { n++; if (d[i] === 0) clear++; }
      if (clear / n > 0.45) finish();
    }
    function finish() {
      if (done) return; done = true;
      foil.classList.add('is-gone'); hint.hidden = true; reveal.hidden = false;
    }

    foil.addEventListener('pointerdown', function (e) { if (done) return; drawing = true; last = null; foil.setPointerCapture(e.pointerId); scratch(pos(e)); });
    foil.addEventListener('pointermove', function (e) { if (drawing && !done) scratch(pos(e)); });
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (t) { foil.addEventListener(t, function () { drawing = false; last = null; }); });

    function open() {
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      pop.classList.add('is-open'); pop.setAttribute('aria-hidden', 'false'); paintFoil(); }
    function close() { pop.classList.remove('is-open'); pop.setAttribute('aria-hidden', 'true'); }

    setTimeout(open, 3000);
    pop.addEventListener('click', function (e) { if (e.target === pop) close(); });
    pop.querySelector('.covr-pop__x').addEventListener('click', close);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

    pop.querySelector('[data-copy]').addEventListener('click', function () {
      var msg = pop.querySelector('.covr-pop__copied');
      if (navigator.clipboard) navigator.clipboard.writeText('COV20').then(function () { msg.textContent = 'Code copied'; });
    });
  })();
</script>
