{%- comment -%}
  COVR V3 icon band for the product page, from the owner's mockup: four
  icons with a title and a line each, on a sand band, separated by rules.
  Written as what the cover is and does; see CHANGES.md AD for the mockup
  lines that were adjusted. Optional eyebrow and heading above the icons
  (product page v2, 14 Oct 2026).
{%- endcomment -%}

{%- liquid
  # Product pages: covers only (the pouch has no strap, handle or racket).
  assign covr_show = true
  if request.page_type == 'product'
    capture covr_side
      render 'covr-v3-side', product: product
    endcapture
    assign covr_side = covr_side | strip
    if covr_side != 'cover'
      assign covr_show = false
    endif
  endif
-%}

{%- if covr_show -%}
<div class="covr-v3-band" {{ section.shopify_attributes }}>
  {%- if section.settings.heading != blank -%}
    <div class="covr-v3-band__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="covr-v3-band__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="covr-v3-band__heading">{{ section.settings.heading | escape }}</h2>
    </div>
  {%- endif -%}
  <ul class="covr-v3-band__list" role="list">
    {%- for block in section.blocks -%}
      <li class="covr-v3-band__item" {{ block.shopify_attributes }}>
        <span class="covr-v3-band__icon">{%- render 'covr-v3-icon', name: block.settings.icon, size: 30 -%}</span>
        <span class="covr-v3-band__title">{{ block.settings.title | escape }}</span>
        <span class="covr-v3-band__text">{{ block.settings.text | escape }}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>
<style>
  .covr-v3-band__head { text-align: center; padding: clamp(40px, 5vw, 64px) 20px 0; }
  .covr-v3-band__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .22em; text-transform: uppercase; opacity: .7; }
  .covr-v3-band__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-weight: 400; font-size: clamp(30px, 3.4vw, 46px); line-height: 1.05; }
  .covr-v3-band__head + .covr-v3-band__list { padding-top: clamp(20px, 2.4vw, 32px); }
</style>
{%- endif -%}

{% schema %}
{
  "name": "COVR V3 icon band",
  "tag": "section",
  "class": "covr-v3-band-wrapper",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "leaf",
          "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "sun", "label": "Sun" }, { "value": "shield", "label": "Shield" }, { "value": "bag", "label": "Bag" }, { "value": "layers", "label": "Layers" } ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Line" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "COVR V3 icon band" }]
}
{% endschema %}
