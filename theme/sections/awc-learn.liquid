{{ 'awc-home.css' | asset_url | stylesheet_tag }}
{%- assign guides = blogs[section.settings.blog] -%}
<section id="guides" class="awc-s {% if section.settings.dark %}awc-dark{% else %}awc-cream{% endif %} awc-pad">
  <div class="awc-wrap">
    <div class="awc-head">
      <span class="awc-eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="awc-h">{{ section.settings.heading }}</h2>
      <p class="awc-lead">{{ section.settings.text }}</p>
    </div>
    {%- if section.settings.show_articles and guides.articles_count > 0 -%}
      <div class="awc-ar">
        {%- for article in guides.articles limit: section.settings.article_count -%}
          <a class="awc-ac" href="{{ article.url }}">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 240, height: 240, crop: 'center' }}" alt="{{ article.title | escape }}" loading="lazy" width="96" height="96">{%- endif -%}
            <div><b>{{ article.title }}</b><small>Read the guide &rarr;</small></div>
          </a>
        {%- endfor -%}
      </div>
      <div class="awc-sub" style="justify-content:center"><a href="{{ guides.url }}">All guides &amp; research &rarr;</a></div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="awc-sub"><h3>{{ section.settings.models_title }}</h3><a href="{{ section.settings.models_link }}">{{ section.settings.models_link_text }} &rarr;</a></div>
      <div class="awc-md{% if section.blocks.size < 6 %} few{% endif %}">
        {%- for block in section.blocks -%}
          <a class="awc-mt" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 160 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="64" height="64">{%- endif -%}
            <b>{{ block.settings.title }}</b><small>{{ block.settings.price }}</small>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AWC Guides + models",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small line","default":"Learn before you buy"},
    {"type":"text","id":"heading","label":"Heading","default":"Rolex guides & research"},
    {"type":"text","id":"text","label":"Text"},
    {"type":"checkbox","id":"dark","label":"Dark background","default":false},
    {"type":"blog","id":"blog","label":"Blog for articles"},
    {"type":"checkbox","id":"show_articles","label":"Show articles","default":true},
    {"type":"range","id":"article_count","label":"Articles shown","min":3,"max":12,"step":3,"default":6},
    {"type":"text","id":"models_title","label":"Model tiles title","default":"Model guides"},
    {"type":"url","id":"models_link","label":"Model tiles link"},
    {"type":"text","id":"models_link_text","label":"Model tiles link text","default":"All models"}
  ],
  "blocks": [
    {"type":"model","name":"Model tile","settings":[
      {"type":"text","id":"title","label":"Name"},
      {"type":"text","id":"price","label":"Price line"},
      {"type":"url","id":"link","label":"Link"},
      {"type":"image_picker","id":"image","label":"Image"}
    ]}
  ],
  "presets": [{"name":"AWC Guides + models"}]
}
{% endschema %}
