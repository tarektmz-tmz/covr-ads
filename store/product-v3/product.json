dge_me_reviews_review_widget_Y3kMrj"],"settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"","section_height_custom":50,"background_media":"none","background_color":"{{ settings.color_palette.background }}","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0}},"covr_details_pdp":{"type":"covr-details","blocks":{"detail_zip":{"type":"detail","settings":{"image":"shopify://shop_images/KEV0100.jpg","image_alt":"Close-up of a cream cotton COVR cover: leather piping, a metal zip and a leather zip pull embossed COVR, beside the crest","focal_x":50,"focal_y":50,"title":"Leather trim, metal hardware","text":"Leather piping runs the perimeter and the zip pull is a leather tab embossed COVR."}},"detail_lining":{"type":"detail","settings":{"image":"shopify://shop_images/KEV0093.jpg","image_alt":"The open top of a COVR cover showing the leather collar with press studs and the lining printed with a repeating CO VR monogram","focal_x":50,"focal_y":45,"title":"Monogram lining, leather collar","text":"A lining printed with a repeating CO/VR monogram, under a leather collar with two press studs that leaves the grip exposed."}},"detail_open":{"type":"detail","settings":{"image":"shopify://shop_images/KEV0199.jpg","image_alt":"A phone being slipped into the zip pocket on the front of a brown COVR cover on a padel court, with the leather collar, its D-ring and the webbing strap in frame","focal_x":50,"focal_y":55,"title":"A zip pocket","text":"A zip pocket takes a phone, keys and cards. An adjustable shoulder strap and a carry handle take it from there."}}},"block_order":["detail_zip","detail_lining","detail_open"],"settings":{"eyebrow":"Up close","heading":"The details","body":"Photographed on the natural and brown covers.","padding-block-start":72,"padding-block-end":8},"disabled":true},"covr_v3_band":{"type":"covr-v3-band","blocks":{"b1":{"type":"item","settings":{"icon":"shield","title":"Protection, between games","text":"Keeps scratches, scuffs and direct sun off your racket whenever you are not playing."}},"b2":{"type":"item","settings":{"icon":"sun","title":"The grip stays out","text":"The handle sits above a leather collar with two press studs, so a damp grip is never shut inside after play."}},"b3":{"type":"item","settings":{"icon":"leaf","title":"Made to last","text":"Cotton, leather trim and metal hardware, finished by hand in Bali. It softens and settles with use."}},"b4":{"type":"item","settings":{"icon":"bag","title":"Easy to carry","text":"A zip pocket for phone, keys and cards, an adjustable shoulder strap and a carry handle."}}},"block_order":["b1","b2","b3","b4"],"settings":{"eyebrow":"Why COVR","heading":"Why padel players choose COVR"}},"covr_v3_photos":{"type":"covr-v3-crafted","blocks":{"p1":{"type":"card","settings":{"image":"shopify://shop_images/KEV0100.jpg","image_alt":"Close-up of the leather zip pull embossed COVR on a cream cover","focal_y":50,"icon":"waves","title":"","text":""}},"p2":{"type":"card","settings":{"image":"shopify://shop_images/KEV0093.jpg","image_alt":"The leather collar with press studs over the COVR monogram lining","focal_y":45,"icon":"leaf","title":"","text":""}},"p3":{"type":"card","settings":{"image":"shopify://shop_images/KEV0199.jpg","image_alt":"A phone going into the front zip pocket of a brown COVR cover","focal_y":55,"icon":"grid","title":"","text":""}}},"block_order":["p1","p2","p3"],"settings":{"show_text":false,"eyebrow":"","heading":"","intro":""}},"covr_faq":{"type":"covr-v4-card","blocks":{"q1":{"type":"question","settings":{"question":"Will it fit my racket?","answer":"<p>It fits most standard padel rackets. The teardrop-shaped cover is 39 × 29 cm and opens on a 36 cm zip that follows the curve.</p>"}},"q2":{"type":"question","settings":{"question":"Why does the grip stay outside?","answer":"<p>The handle sits above a leather collar that closes with two press studs, so a damp grip isn’t shut inside after play, and your racket is ready to grab.</p>"}},"q3":{"type":"question","settings":{"question":"What’s in the box?","answer":"<p>The cover with its adjustable shoulder strap and carry handle, plus a ball pouch in the colour you choose, free with your cover.</p>"}},"q4":{"type":"question","settings":{"question":"How long does delivery take?","answer":"<p>Every cover is made by hand in Bali and ships from our workshop. Free international delivery takes 20 to 30 days from dispatch, or choose DHL Express for $19.99 at checkout. You’ll get a tracking link as soon as it ships.</p>"}},"q5":{"type":"question","settings":{"question":"How do I care for it?","answer":"<p>Spot clean and allow to air dry naturally. Condition the leather occasionally with a neutral leather balm.</p>"}},"q6":{"type":"question","settings":{"question":"Can I return or exchange it?","answer":"<p>If it arrives damaged or faulty, email us with photos and we’ll replace or refund it at our cost. Customers in the UK, EU and EEA can cancel within 14 days of delivery, and unused covers can be exchanged for another colour. <a href=\"/policies/refund-policy\">Refund policy</a></p>"}}},"block_order":["q1","q2","q3","q4","q5","q6"],"settings":{"image":"shopify://shop_images/covr-ginger-cover-on-shoulder-strap.jpg","image_alt":"A cream COVR cover with light brown leather carried on its shoulder strap","focal_y":40,"image_side":"left","eyebrow":"Before you buy","heading":"Got questions?"}},"covr_founder":{"type":"covr-v4-card","disabled":true,"settings":{"image":"shopify://shop_images/covr-two-covers-in-covr-box.jpg","image_alt":"Two COVR covers in a black COVR box","focal_y":50,"image_side":"right","eyebrow":"From our founder","heading":"Why I started COVR","quote":"","name":"","role":"Founder of COVR"}}},"order":["main","covr_v3_band","covr_v3_photos","covr_faq","covr_founder","17670799009d0f0ab7","covr_details_pdp","product_recommendations_qggXJq"]}