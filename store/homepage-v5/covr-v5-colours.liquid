{%- comment -%}
  COVR homepage v5 (15 Oct 2026): "Shop by colour". Every cover in the
  chosen collection as a card (packshot on the page colour, name, price),
  colours in stock first, sold-out colours last and marked.
{%- endcomment -%}

{%- liquid
  assign covr_col = collections[section.settings.collection]
  assign covr_in = ''
  assign covr_out = ''
-%}

<div class="covr-v5-colours" id="shop-by-colour" {{ section.shopify_attributes }}>
  <div class="covr-v5-colours__head">
    {%- if section.settings.eyebrow != blank -%}<p class="covr-v5-colours__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="covr-v5-colours__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="covr-v5-colours__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
  </div>

  {%- if covr_col != blank -%}
    <ul class="covr-v5-colours__grid" role="list">
      {%- for pass in (1..2) -%}
        {%- for p in covr_col.products limit: 24 -%}
          {%- if pass == 1 and p.available == false -%}{%- continue -%}{%- endif -%}
          {%- if pass == 2 and p.available -%}{%- continue -%}{%- endif -%}
          {%- capture covr_name -%}{%- render 'covr-product-presentation', product: p, field: 'name' -%}{%- endcapture -%}
          {%- assign covr_name = covr_name | strip | default: p.title -%}
          <li class="covr-v5-colours__item{% unless p.available %} is-sold-out{% endunless %}">
            <a class="covr-v5-colours__card" href="{{ p.url }}">
              <span class="covr-v5-colours__media">
                {%- if p.featured_media != blank -%}
                  {{ p.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 18vw, 45vw', alt: p.featured_media.alt | default: covr_name, class: 'covr-v5-colours__img' }}
                {%- endif -%}
              </span>
              <span class="covr-v5-colours__name">{{ covr_name | escape }}</span>
              <span class="covr-v5-colours__price">
                {%- if p.available -%}{{ p.price | money_without_trailing_zeros }}{%- else -%}{{ section.settings.sold_out_label | escape }}{%- endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if section.settings.note != blank -%}<p class="covr-v5-colours__note">{{ section.settings.note | escape }}</p>{%- endif -%}
</div>

<style>
  .covr-v5-colours { scroll-margin-top: 90px; padding: 64px clamp(16px, 4vw, 56px); background: #f7f3ec; }
  .covr-v5-colours__head { text-align: center; max-width: 720px; margin: 0 auto 32px; }
  .covr-v5-colours__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .22em; text-transform: uppercase; color: #8f6446; }
  .covr-v5-colours__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-weight: 400; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.05; }
  .covr-v5-colours__intro { margin: 12px 0 0; font-size: 15px; line-height: 1.5; opacity: .8; }
  .covr-v5-colours__grid { list-style: none; margin: 0 auto; padding: 0; max-width: 1240px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px 18px; }
  .covr-v5-colours__card { display: flex; flex-direction: column; align-items: center; text-align: center; text-decoration: none; color: inherit; }
  .covr-v5-colours__media { display: block; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: 14px; background: #f7f3ec; }
  .covr-v5-colours__img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transform: scale(1.08); transition: transform .5s ease; }
  .covr-v5-colours__card:hover .covr-v5-colours__img { transform: scale(1.14); }
  .covr-v5-colours__name { margin-top: 10px; font-family: var(--font-heading--family, inherit); font-size: 20px; line-height: 1.1; }
  .covr-v5-colours__price { margin-top: 4px; font-size: 14px; opacity: .75; }
  .covr-v5-colours__item.is-sold-out { opacity: .55; }
  .covr-v5-colours__item.is-sold-out .covr-v5-colours__price { text-transform: uppercase; letter-spacing: .12em; font-size: 11px; }
  .covr-v5-colours__note { margin: 28px auto 0; text-align: center; font-size: 13px; letter-spacing: .08em; opacity: .75; }
  @media (max-width: 989px) { .covr-v5-colours__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 749px) {
    .covr-v5-colours { padding: 44px 16px; }
    .covr-v5-colours__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 12px; }
    .covr-v5-colours__name { font-size: 18px; }
  }
</style>

{% schema %}
{
  "name": "COVR shop by colour",
  "tag": "section",
  "class": "covr-v5-colours-wrapper",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "Ten colourways" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by colour" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "sold_out_label", "label": "Under sold-out colours", "default": "Sold out" },
    { "type": "text", "id": "note", "label": "Line under the grid" }
  ],
  "presets": [{ "name": "COVR shop by colour" }]
}
{% endschema %}
