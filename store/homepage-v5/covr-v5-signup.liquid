{%- comment -%}
  COVR homepage v5 (15 Oct 2026): email sign-up above the footer. Shopify's
  customer form subscribes the address to email marketing, tagged
  "newsletter".
{%- endcomment -%}

<div class="covr-v5-signup" {{ section.shopify_attributes }}>
  <div class="covr-v5-signup__inner">
    <div class="covr-v5-signup__copy">
      {%- if section.settings.heading != blank -%}<h2 class="covr-v5-signup__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="covr-v5-signup__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'CovrHomeSignup', class: 'covr-v5-signup__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="covr-v5-signup__ok" role="status">{{ section.settings.success | escape }}</p>
      {%- else -%}
        <label class="visually-hidden" for="CovrHomeSignupEmail">Email</label>
        <div class="covr-v5-signup__row">
          <input id="CovrHomeSignupEmail" class="covr-v5-signup__input" type="email" name="contact[email]" placeholder="Your email" autocomplete="email" required>
          <button type="submit" class="covr-v5-signup__button">{{ section.settings.button | escape }}</button>
        </div>
        {%- if form.errors -%}<p class="covr-v5-signup__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <p class="covr-v5-signup__fine">You can unsubscribe at any time.{% if shop.privacy_policy.url != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>{% endif %}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

<style>
  .covr-v5-signup { background: #2a1f18; color: #f5f0e6; padding: 56px clamp(16px, 4vw, 56px); }
  .covr-v5-signup__inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .covr-v5-signup__heading { margin: 0; font-family: var(--font-heading--family, inherit); font-weight: 400; font-size: clamp(28px, 3vw, 40px); line-height: 1.05; color: #f5f0e6; }
  .covr-v5-signup__text { margin: 10px 0 0; font-size: 15px; line-height: 1.5; opacity: .8; }
  .covr-v5-signup__row { display: flex; gap: 8px; }
  .covr-v5-signup .covr-v5-signup__input { flex: 1; min-width: 0; padding: 14px 16px; border: 1px solid #f5f0e6; background: #fffdf8 !important; color: #2a1f18 !important; font-size: 15px; border-radius: 0; }
  .covr-v5-signup .covr-v5-signup__input::placeholder { color: #8a7b6e; opacity: 1; }
  .covr-v5-signup__button { padding: 14px 24px; border: 0; background: #f5f0e6; color: #2a1f18; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; cursor: pointer; }
  .covr-v5-signup__fine, .covr-v5-signup__err, .covr-v5-signup__ok { margin: 10px 0 0; font-size: 12px; opacity: .7; }
  .covr-v5-signup__fine a { color: inherit; }
  .covr-v5-signup__ok { font-size: 15px; opacity: 1; }
  @media (max-width: 749px) { .covr-v5-signup { padding: 44px 16px; } .covr-v5-signup__inner { grid-template-columns: 1fr; gap: 20px; } }
</style>

{% schema %}
{
  "name": "COVR email sign-up",
  "tag": "section",
  "class": "covr-v5-signup-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to know" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New colours, restocks and offers, a few times a month." },
    { "type": "text", "id": "button", "label": "Button", "default": "Sign up" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you. You're on the list." }
  ],
  "presets": [{ "name": "COVR email sign-up" }]
}
{% endschema %}
