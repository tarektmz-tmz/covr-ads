{%- comment -%}
  MAI MURI shared fonts and colour tokens. Rendered at the top of every
  mai-* section; the browser loads the font stylesheet once.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@300;400;500;600&family=Instrument+Serif&display=swap">
<style>
  :root{--mm-ink:#2e2119;--mm-blue:#0a39b0;--mm-teal:#2f6e6f;--mm-pink:#eba7cf;--mm-warm:#e1dcd6;--mm-grey:#f4f2ef;--mm-cream:#f1ede6;--mm-rose:#e7b3a4;--mm-olive:#545a37;--mm-choc:#4a3226;--mm-sans:'Inter Tight',Helvetica,Arial,sans-serif;--mm-serif:'Instrument Serif',Georgia,serif}
  :where(.mm){font-family:var(--mm-sans);color:var(--mm-ink);-webkit-font-smoothing:antialiased}
  :where(.mm) *{box-sizing:border-box}
  :where(.mm) a{color:inherit}
  :where(.mm) .mm-pill{display:inline-flex;align-items:center;gap:6px;border:1.5px solid currentColor;border-radius:999px;padding:7px 16px;font:400 15px/1 var(--mm-sans);letter-spacing:-.01em;text-decoration:none;white-space:nowrap;background:#fff;color:var(--mm-ink);transition:background .2s,color .2s}
  :where(.mm) .mm-pill:hover{background:var(--mm-ink);color:#fff;border-color:var(--mm-ink)}
  :where(.mm) .mm-pill svg{width:15px;height:15px}
</style>
