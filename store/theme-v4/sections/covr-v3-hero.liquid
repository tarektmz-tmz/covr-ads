{%- comment -%}
  COVR hero (v4 preview, 2026-10-13): up to four short videos that cross-fade
  into each other, with the offer headline. Falls back to the photograph when
  no video URL is set. Videos live in Settings > Files (Shopify CDN).
{%- endcomment -%}
{%- liquid
  assign covr_img = section.settings.image
  assign covr_alt = section.settings.image_alt | default: covr_img.alt
  assign covr_vlist = ''
  for i in (1..4)
    assign k = 'video_' | append: i
    if section.settings[k] != blank
      assign covr_vlist = covr_vlist | append: section.settings[k] | strip | append: '~~'
    endif
  endfor
  assign covr_vids = covr_vlist | split: '~~'
  assign covr_h1_eyebrow = false
  if section.settings.h1 == 'eyebrow' and section.settings.eyebrow != blank
    assign covr_h1_eyebrow = true
  endif
-%}
<div class="covr-v4-hero" id="covr-v4-hero-{{ section.id }}" style="--bg: {{ section.settings.background | default: '#efefef' }};" {{ section.shopify_attributes }}>
  <div class="covr-v4-hero__copy">
    {%- if section.settings.eyebrow != blank -%}
      {%- if covr_h1_eyebrow -%}<h1 class="covr-v4-hero__eyebrow">{{ section.settings.eyebrow | escape | newline_to_br }}</h1>
      {%- else -%}<p class="covr-v4-hero__eyebrow">{{ section.settings.eyebrow | escape | newline_to_br }}</p>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      {%- if covr_h1_eyebrow -%}<p class="covr-v4-hero__heading">{{ section.settings.heading | escape }}</p>
      {%- else -%}<h1 class="covr-v4-hero__heading">{{ section.settings.heading | escape }}</h1>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.body != blank -%}<p class="covr-v4-hero__body">{{ section.settings.body | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="covr-v4-hero__cta" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if covr_vids.size > 1 -%}
      <div class="covr-v4-hero__dots" aria-hidden="true">{%- for v in covr_vids -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>
    {%- endif -%}
  </div>
  <div class="covr-v4-hero__media">
    {%- if covr_vids.size > 0 -%}
      {%- for v in covr_vids -%}
        <video class="covr-v4-hero__vid{% if forloop.first %} on{% endif %}" src="{{ v }}" muted playsinline preload="{% if forloop.first %}auto{% else %}metadata{% endif %}" {% if forloop.first %}autoplay{% endif %} {% if covr_vids.size == 1 %}loop{% endif %} aria-label="{{ covr_alt | escape }}"></video>
      {%- endfor -%}
    {%- elsif covr_img != blank -%}
      {{ covr_img | image_url: width: 1500 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 50vw, 100vw', widths: '600, 900, 1200, 1500', alt: covr_alt }}
    {%- endif -%}
  </div>
</div>

<style>
  .covr-v4-hero{--ink:#2a1f18;--tan:#8f6446;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:var(--bg);min-height:min(88svh,860px)}
  .covr-v4-hero__copy{display:flex;flex-direction:column;justify-content:center;gap:20px;padding:clamp(40px,6vw,96px) clamp(20px,6vw,96px);max-width:640px}
  .covr-v4-hero__eyebrow{margin:0;font:500 12px/1.7 var(--font-body--family);letter-spacing:.2em;text-transform:uppercase;color:var(--tan)}
  .covr-v4-hero__heading{margin:0;font-family:var(--font-heading--family,serif);font-size:clamp(44px,5.6vw,84px);line-height:.98;color:var(--ink);letter-spacing:-.01em}
  .covr-v4-hero__body{margin:0;max-width:34ch;color:#5d5750;font-size:16px;line-height:1.6}
  .covr-v4-hero__cta{align-self:flex-start;background:var(--ink);color:#f5f0e6;text-decoration:none;padding:17px 30px;font:600 12px/1 var(--font-body--family);letter-spacing:.18em;text-transform:uppercase;transition:background .2s}
  .covr-v4-hero__cta:hover{background:var(--tan)}
  .covr-v4-hero__dots{display:flex;gap:8px}
  .covr-v4-hero__dots i{width:26px;height:2px;background:rgba(42,31,24,.2);position:relative;overflow:hidden}
  .covr-v4-hero__dots i.on::after{content:"";position:absolute;inset:0;background:var(--ink);animation:covrbar var(--dur,6s) linear forwards}
  @keyframes covrbar{from{transform:translateX(-100%)}to{transform:none}}
  .covr-v4-hero__media{position:relative;overflow:hidden;background:#d9d2c7}
  .covr-v4-hero__media video,.covr-v4-hero__media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .covr-v4-hero__vid{opacity:0;transform:scale(1.06);transition:opacity 1.1s ease,transform 7s ease-out}
  .covr-v4-hero__vid.on{opacity:1;transform:none}
  @media (max-width:749px){
    .covr-v4-hero{grid-template-columns:1fr;min-height:0;position:relative}
    .covr-v4-hero__media{height:82svh;order:-1}
    .covr-v4-hero__copy{position:absolute;inset:auto 0 0 0;z-index:2;padding:90px 20px 30px;gap:14px;background:linear-gradient(180deg,rgba(20,14,10,0),rgba(20,14,10,.6) 22%,rgba(20,14,10,.86) 60%);max-width:none;text-shadow:0 1px 12px rgba(0,0,0,.35)}
    .covr-v4-hero__eyebrow{color:#e2c9a8}.covr-v4-hero__heading{color:#f5f0e6;font-size:44px}.covr-v4-hero__body{color:rgba(245,240,230,.88)}
    .covr-v4-hero__cta{background:#f5f0e6;color:var(--ink)}
    .covr-v4-hero__dots i{background:rgba(245,240,230,.3)}.covr-v4-hero__dots i.on::after{background:#f5f0e6}
  }
  @media (prefers-reduced-motion:reduce){.covr-v4-hero__vid{transition:none;transform:none}}
</style>
<script>
  (function(){
    var root=document.getElementById('covr-v4-hero-{{ section.id }}');if(!root)return;
    var v=[].slice.call(root.querySelectorAll('video')),d=[].slice.call(root.querySelectorAll('.covr-v4-hero__dots i'));
    if(v.length<2){if(v[0])v[0].play().catch(function(){});return;}
    var i=0;
    function show(n){
      var prev=v[i];i=n;var cur=v[i];
      try{cur.currentTime=0}catch(e){}
      cur.play().catch(function(){});cur.classList.add('on');prev.classList.remove('on');
      setTimeout(function(){prev.pause()},1200);
      d.forEach(function(x,k){x.classList.remove('on');if(k===i){void x.offsetWidth;x.style.setProperty('--dur',((cur.duration||6)-0.6)+'s');x.classList.add('on')}});
    }
    v.forEach(function(x,k){x.addEventListener('timeupdate',function(){if(k===i&&x.duration&&x.currentTime>x.duration-0.6&&!x._n){x._n=1;setTimeout(function(){x._n=0},1500);show((i+1)%v.length)}});
      x.addEventListener('ended',function(){if(k===i)show((i+1)%v.length)});});
    v[0].addEventListener('loadedmetadata',function(){if(d[0])d[0].style.setProperty('--dur',(v[0].duration-0.6)+'s')});
    v[0].play().catch(function(){});
  })();
</script>

{% schema %}
{
  "name": "COVR V3 hero",
  "tag": "section",
  "class": "covr-v3-hero-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "video_1", "label": "Video 1 URL (MP4)" },
    { "type": "text", "id": "video_2", "label": "Video 2 URL (MP4)" },
    { "type": "text", "id": "video_3", "label": "Video 3 URL (MP4)" },
    { "type": "text", "id": "video_4", "label": "Video 4 URL (MP4)" },
    { "type": "image_picker", "id": "image", "label": "Photograph (used when no video)" },
    { "type": "text", "id": "placeholder", "label": "Placeholder asset", "default": "covr-v3-ph-hero.jpg" },
    { "type": "text", "id": "image_alt", "label": "Alternative text" },
    { "type": "range", "id": "position_desktop", "label": "Photograph position, desktop", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "position_mobile", "label": "Photograph position, phones", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
    { "type": "color", "id": "background", "label": "Background", "default": "#efefef" },
    { "type": "textarea", "id": "eyebrow", "label": "Eyebrow (two lines)" },
    { "type": "text", "id": "heading", "label": "Headline" },
    { "type": "text", "id": "offer", "label": "Offer line" },
    { "type": "select", "id": "h1", "label": "Page heading (H1)", "default": "headline", "options": [ { "value": "headline", "label": "The headline" }, { "value": "eyebrow", "label": "The eyebrow" } ] },
    { "type": "textarea", "id": "body", "label": "Supporting sentence" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "COVR V3 hero" }]
}
{% endschema %}
