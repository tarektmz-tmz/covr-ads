{%- comment -%}
  COVR product page v2: a rounded card with a photograph on one side and
  text on the other (borrowed from the Bloom layout). Used twice on the
  product page: "Got questions?" (question blocks become an accordion) and
  "From our founder" (quote and name). Covers only on product pages.
{%- endcomment -%}

{%- liquid
  assign covr_show = true
  if request.page_type == 'product'
    capture covr_side
      render 'covr-v3-side', product: product
    endcapture
    assign covr_side = covr_side | strip
    if covr_side != 'cover'
      assign covr_show = false
    endif
  endif
-%}

{%- if covr_show -%}
<div class="covr-v4-card-wrap" {{ section.shopify_attributes }}>
  <div class="covr-v4-card{% if section.settings.image_side == 'right' %} covr-v4-card--flip{% endif %}">
    <div class="covr-v4-card__media">
      {%- if section.settings.image != blank -%}
        {%- assign covr_pos = 'object-position: 50% ' | append: section.settings.focal_y | append: '%' -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image_alt, style: covr_pos }}
      {%- endif -%}
    </div>
    <div class="covr-v4-card__body">
      {%- if section.settings.eyebrow != blank -%}<p class="covr-v4-card__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="covr-v4-card__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.quote != blank -%}
        <blockquote class="covr-v4-card__quote">{{ section.settings.quote }}</blockquote>
        {%- if section.settings.name != blank -%}<p class="covr-v4-card__name">{{ section.settings.name | escape }}{%- if section.settings.role != blank -%}<span>{{ section.settings.role | escape }}</span>{%- endif -%}</p>{%- endif -%}
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="covr-v4-card__faq">
          {%- for block in section.blocks -%}
            <details class="covr-v4-card__q" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}<span aria-hidden="true"></span></summary>
              <div class="covr-v4-card__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<style>
  .covr-v4-card-wrap { padding: clamp(16px, 3vw, 40px) clamp(16px, 3vw, 40px); }
  .covr-v4-card { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; border-radius: 22px; overflow: hidden; background: #fbf8f3; box-shadow: 0 1px 0 rgba(43, 30, 22, .06), 0 18px 40px -24px rgba(43, 30, 22, .28); }
  .covr-v4-card--flip .covr-v4-card__media { order: 2; }
  .covr-v4-card__media { position: relative; min-height: 420px; background: #e9e1d4; }
  .covr-v4-card__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .covr-v4-card__body { padding: clamp(28px, 4.4vw, 64px); display: flex; flex-direction: column; justify-content: center; }
  .covr-v4-card__eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .22em; text-transform: uppercase; opacity: .7; }
  .covr-v4-card__heading { margin: 0 0 20px; font-family: var(--font-heading--family, inherit); font-weight: 400; font-size: clamp(30px, 3.2vw, 44px); line-height: 1.05; }
  .covr-v4-card__quote { margin: 0; font-family: var(--font-heading--family, inherit); font-style: italic; font-size: clamp(20px, 1.8vw, 26px); line-height: 1.35; }
  .covr-v4-card__name { margin: 22px 0 0; font-size: 14px; letter-spacing: .06em; }
  .covr-v4-card__name span { display: block; margin-top: 4px; opacity: .65; }
  .covr-v4-card__faq { border-top: 1px solid rgba(43, 30, 22, .14); }
  .covr-v4-card__q { border-bottom: 1px solid rgba(43, 30, 22, .14); }
  .covr-v4-card__q summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 16px 0; font-size: 15px; }
  .covr-v4-card__q summary::-webkit-details-marker { display: none; }
  .covr-v4-card__q summary span { flex: none; width: 22px; height: 22px; border-radius: 50%; background: #2b1e16; position: relative; }
  .covr-v4-card__q summary span::before, .covr-v4-card__q summary span::after { content: ""; position: absolute; left: 6px; right: 6px; top: 10.25px; height: 1.5px; background: #f7f3ec; }
  .covr-v4-card__q summary span::after { transform: rotate(90deg); transition: transform .2s; }
  .covr-v4-card__q[open] summary span::after { transform: rotate(0); }
  .covr-v4-card__a { padding: 0 0 18px; font-size: 14px; line-height: 1.6; opacity: .85; }
  .covr-v4-card__a p { margin: 0; }
  @media (max-width: 749px) {
    .covr-v4-card { grid-template-columns: 1fr; border-radius: 18px; }
    .covr-v4-card--flip .covr-v4-card__media { order: 0; }
    .covr-v4-card__media { min-height: 300px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "COVR card",
  "tag": "section",
  "class": "covr-v4-card-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "image_alt", "label": "Photo description" },
    { "type": "range", "id": "focal_y", "label": "Photo focus (top to bottom)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "select", "id": "image_side", "label": "Photo side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "name", "label": "Name under the quote" },
    { "type": "text", "id": "role", "label": "Role under the name" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "COVR card" }]
}
{% endschema %}
