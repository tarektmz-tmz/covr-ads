{{ 'awc-home.css' | asset_url | stylesheet_tag }}
<section class="awc-s awc-cream awc-pad">
  <div class="awc-wrap">
    <div class="awc-head"><span class="awc-eyebrow">{{ section.settings.eyebrow }}</span><h2 class="awc-h">{{ section.settings.heading }}</h2></div>
    <div class="awc-vals">
      {%- for block in section.blocks -%}<div class="awc-val" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>{%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AWC Values",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small line","default":"How we work"},
    {"type":"text","id":"heading","label":"Heading","default":"Our commitment"}
  ],
  "blocks": [
    {"type":"value","name":"Value","settings":[{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Text"}]}
  ],
  "presets": [{"name":"AWC Values"}]
}
{% endschema %}
