{%- comment -%}
  Ceylora: photo sizes and custom section styles.
  Product gallery fills its column (max 720px) and stays in view while the details scroll.
  Image blocks max 560px, except the homepage hero. Mobile stays full width.
{%- endcomment -%}
<style>
  @media screen and (min-width: 750px) {
    media-gallery {
      width: 100%;
      max-width: 720px;
      margin-inline: auto;
      position: sticky;
      top: calc(var(--header-height, 72px) + 24px);
      align-self: flex-start;
    }

    .image-block {
      max-width: 560px;
    }

    [id$='__section_aweKy6'] .image-block {
      max-width: none;
    }
  }

  /* Brown gradient backgrounds: comparison and guarantee sections */
  [id$='__section_compare'] {
    background: linear-gradient(135deg, #c27440 0%, #a8552a 55%, #8a3d17 100%);
  }

  [id$='__section_LbdznP'] {
    background: radial-gradient(circle at 50% 30%, #b8673a 0%, #9a4a24 55%, #7a3312 100%);
  }

  [id$='__section_compare'] .section-background,
  [id$='__section_compare'] .section,
  [id$='__section_LbdznP'] .section-background,
  [id$='__section_LbdznP'] .section {
    background: transparent !important;
  }

  [id$='__section_compare'] .image-block {
    max-width: 520px;
    filter: drop-shadow(0 18px 30px rgba(50, 15, 0, 0.25));
  }

  [id$='__section_LbdznP'] .image-block {
    max-width: 200px;
    width: 200px;
    filter: drop-shadow(0 10px 20px rgba(50, 15, 0, 0.3));
  }

  [id$='__section_compare'] .button,
  [id$='__section_LbdznP'] .button {
    border-radius: 999px;
    padding: 18px 44px;
    font-weight: 600;
    box-shadow: 0 10px 24px rgba(40, 10, 0, 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  [id$='__section_compare'] .button:hover,
  [id$='__section_LbdznP'] .button:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(40, 10, 0, 0.32);
  }

  /* Product description: closed tabs that open on click and move out on hover */
  .ceylora-tabs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
  }

  .ceylora-tab {
    border: 1.5px solid #e6d6c7;
    border-radius: 14px;
    background: #fff;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .ceylora-tab:hover {
    transform: translateX(8px);
    border-color: #b8673a;
    box-shadow: -6px 8px 22px rgba(120, 50, 15, 0.14);
  }

  .ceylora-tab > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    font-weight: 600;
    font-size: 1.05em;
    cursor: pointer;
    list-style: none;
  }

  .ceylora-tab > summary::-webkit-details-marker {
    display: none;
  }

  .ceylora-tab > summary::after {
    content: '+';
    flex: 0 0 28px;
    height: 28px;
    border-radius: 50%;
    background: #b8673a;
    color: #fff;
    font-size: 20px;
    line-height: 28px;
    text-align: center;
    transition: transform 0.25s ease;
  }

  .ceylora-tab[open] > summary::after {
    transform: rotate(45deg);
  }

  .ceylora-tab[open] {
    border-color: #b8673a;
  }

  .ceylora-tab > div {
    padding: 0 20px 16px;
    animation: ceylora-tab-in 0.3s ease;
  }

  @keyframes ceylora-tab-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  /* Footer */
  [id$='__ceylora_footer'] a {
    color: inherit;
  }

  [id$='__ceylora_footer'] a:hover {
    color: #fff;
  }

  /* Product page benefit points: one per row on phones */
  @media screen and (max-width: 749px) {
    .group-block-content.layout-panel-flex--row:has(> .group-block [id$='__ppt0_i']),
    .group-block-content.layout-panel-flex--row:has(> .group-block [id$='__ppt2_i']) {
      flex-direction: column !important;
      align-items: stretch !important;
    }
  }
</style>
