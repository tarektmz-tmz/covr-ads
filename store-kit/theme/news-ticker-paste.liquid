<!-- Ceyllora moving news line. In Shopify: Online Store > Themes > (live theme) ... > Edit code > snippets > ceylora-sizes.liquid
     Scroll to the very bottom, delete the last line </style> and paste everything below this comment in its place. Save. -->

  /* Announcement bar as a moving news ticker */
  .ceylora-ticker {
    position: relative;
    overflow: hidden;
    width: 100%;
    color: #fff8f1;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
  }

  .ceylora-ticker__track {
    display: flex;
    width: max-content;
    animation: ceylora-ticker 28s linear infinite;
  }

  .ceylora-ticker:hover .ceylora-ticker__track {
    animation-play-state: paused;
  }

  .ceylora-ticker__group {
    display: flex;
  }

  .ceylora-ticker__item {
    display: inline-block;
    white-space: nowrap;
  }

  .ceylora-ticker__item::after {
    content: '✦';
    margin: 0 2.5rem;
    opacity: 0.7;
  }

  .ceylora-ticker__link {
    position: absolute;
    inset: 0;
  }

  @keyframes ceylora-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ceylora-ticker__track {
      animation-duration: 60s;
    }
  }
</style>
<script>
  (function () {
    // Swap the announcement slideshow for a scrolling ticker, keeping the messages set in the editor.
    function buildTicker() {
      var slider = document.querySelector('.announcement-bar__slider');
      if (!slider) return;
      var items = Array.prototype.map.call(slider.querySelectorAll('.announcement-bar__text'), function (p) {
        return p.innerHTML.trim();
      });
      if (!items.length) return;
      var link = slider.querySelector('.announcement-bar__link');
      var repeated = items.concat(items, items);
      var group =
        '<div class="ceylora-ticker__group">' +
        repeated.map(function (text) { return '<span class="ceylora-ticker__item">' + text + '</span>'; }).join('') +
        '</div>';
      var ticker = document.createElement('div');
      ticker.className = 'ceylora-ticker';
      ticker.innerHTML = '<div class="ceylora-ticker__track">' + group + group + '</div>';
      if (link) {
        var a = document.createElement('a');
        a.href = link.href;
        a.className = 'ceylora-ticker__link';
        a.setAttribute('aria-label', items.join(' · ').replace(/<[^>]+>/g, ''));
        ticker.appendChild(a);
      }
      slider.replaceWith(ticker);
    }
    if (document.readyState !== 'loading') buildTicker();
    else document.addEventListener('DOMContentLoaded', buildTicker);
  })();
</script>
