{%- comment -%}
  MAI MURI product card. Params: product, variant, name, tag, note.
  Photo on a light grey tile, name, price, a black rounded Add to Bag button.
{%- endcomment -%}
{%- assign img = variant.featured_image | default: product.featured_image -%}
<li class="mm-card">
  <a class="mm-card__photo" href="{{ variant.url | default: product.url }}">
    {%- if note != blank -%}<span class="mm-card__note">{{ note | escape }}</span>{%- endif -%}
    {%- if img != blank -%}{{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 18vw, 50vw', alt: name }}{%- endif -%}
  </a>
  <a class="mm-card__name" href="{{ variant.url | default: product.url }}">{{ name | escape }}</a>
  <p class="mm-card__price">{{ variant.price | money }}</p>
  <form method="post" action="{{ routes.cart_add_url }}" class="mm-card__form">
    <input type="hidden" name="id" value="{{ variant.id }}">
    <input type="hidden" name="quantity" value="1">
    {%- if variant.available -%}
      <button type="submit" class="mm-card__btn">Add to Bag</button>
    {%- else -%}
      <button type="button" class="mm-card__btn mm-card__btn--off" disabled>Sold out</button>
    {%- endif -%}
  </form>
  {%- if tag != blank -%}<span class="mm-card__tag">{{ tag | escape }}</span>{%- endif -%}
</li>
