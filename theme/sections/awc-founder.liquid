{{ 'awc-home.css' | asset_url | stylesheet_tag }}
<section class="awc-s awc-pad" style="background:#fff">
  <div class="awc-wrap">
    <div class="awc-fd">
      <div class="awc-fd-img">
        {%- if section.settings.image != blank -%}
          <img class="main" src="{{ section.settings.image | image_url: width: 900 }}" alt="Tarek Shammout, founder of Advance Watch Co." loading="lazy">
        {%- endif -%}
        <div class="badge"><strong>{{ section.settings.badge_number }}</strong><span>{{ section.settings.badge_label }}</span></div>
      </div>
      <div>
        <span class="awc-eyebrow">{{ section.settings.eyebrow }}</span>
        <h2 class="awc-h">{{ section.settings.heading }}</h2>
        <div>{{ section.settings.text }}</div>
        <div class="awc-tl">
          {%- for block in section.blocks -%}{%- if block.type == 'step' -%}<div {{ block.shopify_attributes }}><b>{{ block.settings.year }}</b>{{ block.settings.text }}</div>{%- endif -%}{%- endfor -%}
        </div>
        <ul class="awc-offers">
          {%- for block in section.blocks -%}{%- if block.type == 'offer' -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        {%- if section.settings.button_text != blank -%}
          <div class="awc-btns"><a class="awc-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a><a class="awc-btn wa" href="https://wa.me/971561853856?text=Hi%20Tarek%2C%20I%27d%20like%20to%20talk%20about%20a%20watch.">Message Tarek</a></div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_gallery -%}
      <div class="awc-gal">
        {%- for i in (1..3) -%}
          {%- liquid
            assign ik = 'gal_' | append: i
            assign ck = 'gal_cap_' | append: i
          -%}
          {%- if section.settings[ik] != blank -%}
            <figure><img src="{{ section.settings[ik] | image_url: width: 700 }}" alt="{{ section.settings[ck] }}" loading="lazy"><figcaption>{{ section.settings[ck] }}</figcaption></figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "AWC Founder / About",
  "settings": [
    {"type":"image_picker","id":"image","label":"Founder photo"},
    {"type":"text","id":"badge_number","label":"Badge number","default":"2019"},
    {"type":"text","id":"badge_label","label":"Badge label","default":"Joined Rolex, Dubai Mall"},
    {"type":"text","id":"eyebrow","label":"Small line","default":"The founder"},
    {"type":"text","id":"heading","label":"Heading","default":"Hi, I'm Tarek."},
    {"type":"richtext","id":"text","label":"Text"},
    {"type":"text","id":"button_text","label":"Button text"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"checkbox","id":"show_gallery","label":"Show photo strip","default":false},
    {"type":"image_picker","id":"gal_1","label":"Photo 1"},{"type":"text","id":"gal_cap_1","label":"Caption 1"},
    {"type":"image_picker","id":"gal_2","label":"Photo 2"},{"type":"text","id":"gal_cap_2","label":"Caption 2"},
    {"type":"image_picker","id":"gal_3","label":"Photo 3"},{"type":"text","id":"gal_cap_3","label":"Caption 3"}
  ],
  "blocks": [
    {"type":"step","name":"Timeline step","settings":[{"type":"text","id":"year","label":"Year"},{"type":"text","id":"text","label":"Text"}]},
    {"type":"offer","name":"What you get","settings":[{"type":"text","id":"text","label":"Text"}]}
  ],
  "presets": [{"name":"AWC Founder / About"}]
}
{% endschema %}
