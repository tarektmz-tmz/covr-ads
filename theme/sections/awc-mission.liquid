{{ 'awc-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign vurl = ''
  if section.settings.video != blank
    assign best = 99999
    for s in section.settings.video.sources
      if s.format == 'mp4'
        if s.height >= 720 and s.height < best
          assign best = s.height
          assign vurl = s.url
        elsif vurl == blank
          assign vurl = s.url
        endif
      endif
    endfor
  endif
-%}
<section id="awc-mission-{{ section.id }}" class="awc-s awc-dark awc-pad">
  <div class="awc-wrap awc-mission-grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="awc-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="awc-h">{{ section.settings.heading }}</h2>
      <div class="awc-lead">{{ section.settings.text }}</div>
      <div class="awc-points">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <div class="awc-point" {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="awc-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="awc-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.number }}</strong><span>{{ block.settings.label }}</span></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="awc-btns">
        {%- if section.settings.button_1_text != blank -%}<a class="awc-btn" href="{{ section.settings.button_1_link }}">{{ section.settings.button_1_text }}</a>{%- endif -%}
        {%- if section.settings.button_2_text != blank -%}<a class="awc-btn wa" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_text }}</a>{%- endif -%}
        {%- if section.settings.button_3_text != blank -%}<a class="awc-btn ghost" href="{{ section.settings.button_3_link }}">{{ section.settings.button_3_text }}</a>{%- endif -%}
      </div>
    </div>
    <div class="awc-video">
      {%- if vurl != blank -%}
        <video src="{{ vurl }}" muted loop playsinline preload="none" {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 900 }}"{% endif %} aria-label="Advance Watch Co brand video"></video>
        <button type="button" data-snd>Sound off</button>
      {%- elsif section.settings.poster != blank -%}
        <img src="{{ section.settings.poster | image_url: width: 900 }}" alt="Advance Watch Co" style="width:100%;height:100%;object-fit:cover" loading="lazy">
      {%- endif -%}
      <span class="tag">{{ section.settings.video_tag }}</span>
    </div>
  </div>
  <script>
    (function(){
      var s=document.getElementById('awc-mission-{{ section.id }}');if(!s)return;
      var v=s.querySelector('video'),b=s.querySelector('[data-snd]');if(!v)return;
      v.muted=true;
      if('IntersectionObserver' in window){new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){});}else v.pause();});},{threshold:.35}).observe(v);}else{v.play();}
      if(b)b.addEventListener('click',function(){v.muted=!v.muted;b.textContent=v.muted?'Sound off':'Sound on';if(!v.muted)v.play();});
    })();
  </script>
</section>

{% schema %}
{
  "name": "AWC Mission + video",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small line","default":"Why Advance Watch Co."},
    {"type":"text","id":"heading","label":"Heading","default":"Built by someone who worked inside Rolex."},
    {"type":"richtext","id":"text","label":"Text","default":"<p>From 2019 to 2023 I worked at the Rolex store in Dubai Mall.</p>"},
    {"type":"text","id":"button_1_text","label":"Button 1 text","default":"Shop watches in stock"},
    {"type":"url","id":"button_1_link","label":"Button 1 link"},
    {"type":"text","id":"button_2_text","label":"Button 2 text","default":"Ask on WhatsApp"},
    {"type":"text","id":"button_2_link","label":"Button 2 link","default":"https://wa.me/971561853856"},
    {"type":"text","id":"button_3_text","label":"Button 3 text"},
    {"type":"url","id":"button_3_link","label":"Button 3 link"},
    {"type":"video","id":"video","label":"Video"},
    {"type":"image_picker","id":"poster","label":"Video poster"},
    {"type":"text","id":"video_tag","label":"Video label","default":"Inside Advance Watch Co."}
  ],
  "blocks": [
    {"type":"point","name":"Point","settings":[{"type":"text","id":"title","label":"Title"},{"type":"text","id":"text","label":"Text"}]},
    {"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number"},{"type":"text","id":"label","label":"Label"}]}
  ],
  "presets": [{"name":"AWC Mission + video"}]
}
{% endschema %}
