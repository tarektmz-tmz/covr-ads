      "type": "covr-v4-card",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Will it fit my racket?",
            "answer": "<p>It fits most standard padel rackets. The teardrop-shaped cover is 39 × 29 cm.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How is it different from Signature?",
            "answer": "<p>The Essential zips all the way round, so the whole racket, grip included, sits inside. Signature leaves the grip out under a leather collar and adds leather trim and a front zip pocket.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What’s in the box?",
            "answer": "<p>The cover with its clip-on adjustable shoulder strap. Add a COVR ball pouch above if you’d like one.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Every cover is made by hand in Bali and ships from our workshop. Free international delivery takes 20 to 30 days from dispatch, or choose DHL Express for $19.99 at checkout. You’ll get a tracking link as soon as it ships.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How do I care for it?",
            "answer": "<p>Spot clean and allow to air dry naturally.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Can I return or exchange it?",
            "answer": "<p>If it arrives damaged or faulty, email us with photos and we’ll replace or refund it at our cost. Customers in the UK, EU and EEA can cancel within 14 days of delivery, and unused covers can be exchanged for another colour. <a href=\"/policies/refund-policy\">Refund policy</a></p>"
          }
        }
      },
