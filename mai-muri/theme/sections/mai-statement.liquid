{%- comment -%}
  MAI MURI statement: very large serif lines in the centre, one short
  sentence under them, then a row of numbered facts (blocks).
{%- endcomment -%}
{%- render 'mai-base' -%}
<section class="mm mm-st" style="--mm-st-bg:{{ section.settings.background }}">
  <h2 class="mm-st__big">{{ section.settings.line_1 | escape }}{%- if section.settings.line_2 != blank -%}<br><em>{{ section.settings.line_2 | escape }}</em>{%- endif -%}</h2>
  {%- if section.settings.text != blank -%}<p class="mm-st__text">{{ section.settings.text | escape }}</p>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <ol class="mm-st__facts" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <span class="mm-st__n">{{ forloop.index | prepend: '0' }}</span>
          <span class="mm-st__t">{{ block.settings.title | escape }}</span>
          <span class="mm-st__d">{{ block.settings.text | escape }}</span>
        </li>
      {%- endfor -%}
    </ol>
  {%- endif -%}
</section>
<style>
  .mm-st{padding:clamp(56px,7vw,110px) clamp(16px,2.6vw,50px) clamp(48px,6vw,90px);text-align:center;background:var(--mm-st-bg,#fff)}
  .mm-st__big{margin:0;font:400 clamp(64px,9vw,150px)/.86 var(--mm-serif);letter-spacing:-.01em}
  .mm-st__big em{font-style:italic;color:#c9806e}
  .mm-st__text{margin:clamp(18px,2vw,28px) auto 0;max-width:60ch;font:400 clamp(16px,1.3vw,20px)/1.45 var(--mm-sans);letter-spacing:-.01em}
  .mm-st__facts{list-style:none;margin:clamp(40px,5vw,72px) auto 0;padding:0;max-width:1400px;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));text-align:left;border-top:1.5px solid var(--mm-ink)}
  .mm-st__facts li{display:grid;gap:8px;align-content:start;padding:20px clamp(12px,1.4vw,24px) 6px 0}
  .mm-st__facts li+li{padding-left:clamp(12px,1.4vw,24px);border-left:1px solid rgba(17,17,17,.15)}
  .mm-st__n{font:500 12px/1 var(--mm-sans);letter-spacing:.08em;color:#c9806e}
  .mm-st__t{font:400 clamp(22px,1.9vw,30px)/1.1 var(--mm-sans);letter-spacing:-.03em}
  .mm-st__d{font:400 15px/1.5 var(--mm-sans);color:#55524e}
  @media (max-width:749px){.mm-st__facts{grid-template-columns:1fr 1fr}.mm-st__facts li:nth-child(3){padding-left:0;border-left:0}.mm-st__facts li:nth-child(n+3){border-top:1px solid rgba(17,17,17,.15)}}
</style>

{% schema %}
{
  "name": "MAI MURI statement",
  "tag": "div",
  "class": "mai-statement-section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "line_1", "label": "Big line 1", "default": "MAI MURI" },
    { "type": "text", "id": "line_2", "label": "Big line 2", "default": "On You" },
    { "type": "textarea", "id": "text", "label": "Sentence under it" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Detail" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "MAI MURI statement" }]
}
{% endschema %}
