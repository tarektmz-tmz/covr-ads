{%- doc -%}
  COVR product page v2: up to three small benefit tags under the product
  heading (borrowed from the Bloom layout). Cover pages only.
{%- enddoc -%}

{%- liquid
  capture covr_side
    render 'covr-v3-side', product: closest.product
  endcapture
  assign covr_side = covr_side | strip
-%}

{%- if covr_side == 'cover' -%}
  <ul class="covr-v4-tags" role="list" {{ block.shopify_attributes }}>
    {%- for i in (1..3) -%}
      {%- assign covr_key = 'tag_' | append: i -%}
      {%- assign covr_tag = block.settings[covr_key] -%}
      {%- if covr_tag != blank -%}
        <li class="covr-v4-tags__tag">{{ covr_tag | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
  <style>
    .covr-v4-tags { list-style: none; margin: -8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .covr-v4-tags__tag { padding: 7px 14px; border: 1px solid rgba(43, 30, 22, .18); border-radius: 999px; background: rgba(255, 255, 255, .55); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; line-height: 1.2; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "COVR tags",
  "tag": null,
  "settings": [
    { "type": "text", "id": "tag_1", "label": "Tag 1" },
    { "type": "text", "id": "tag_2", "label": "Tag 2" },
    { "type": "text", "id": "tag_3", "label": "Tag 3" }
  ]
}
{% endschema %}
